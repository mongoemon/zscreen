{
  "name": "zcreenshot",
  "version": "1.7.2",
  "description": "Screenshot stacking editor - paste or drop images, arrange them freely",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:report": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/allure-reporter.js --test-reporter-destination=stdout",
    "report": "npx -y allure@3.22.1 generate allure-results",
    "icon": "node scripts/make-icon.js",
    "build:web": "node scripts/make-icon.js && node scripts/build-web.js",
    "serve:web": "node scripts/serve-web.js",
    "stt:model": "node scripts/fetch-stt-model.js",
    "dist:win": "node scripts/fetch-stt-model.js && electron-builder --win",
    "dist:mac": "node scripts/fetch-stt-model.js && electron-builder --mac"
  },
  "build": {
    "appId": "com.zcreenshot.app",
    "productName": "Zcreenshot",
    "files": ["*.js", "index.html", "style.css", "ocr/**", "stt/**", "build/icon.png", "THIRD_PARTY_LICENSES.txt"],
    "extraFiles": ["THIRD_PARTY_LICENSES.txt"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design",
      "extendInfo": { "NSMicrophoneUsageDescription": "Zcreenshot records your microphone into screen recordings, and for speech to text, when you turn it on." }
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
